# Flightdeck settings. Copy to .env (gitignored) and change what you need; every line is optional.
# The server reads .env from its working directory (or FLIGHTDECK_ENV_FILE); a variable already in
# the environment wins over the file. scripts/mac/install.sh reads this file too and bakes the
# address into Flightdeck.app, so re-run it after changing one of the first four.

# --- Address --------------------------------------------------------------------------------------
# Loopback only, always. The page opens at http://$FLIGHTDECK_HOST_NAME:$FLIGHTDECK_PORT.
#FLIGHTDECK_PORT=8100
#FLIGHTDECK_HOST_NAME=flightdeck.localhost     # *.localhost needs no /etc/hosts entry
# A port-less address, e.g. http://flightdeck.test, set up once with `sudo scripts/mac/port80.sh`.
# Unset = none. It forwards to FLIGHTDECK_FORWARD_PORT, a second port the server opens for it.
#FLIGHTDECK_BARE_HOST=
#FLIGHTDECK_FORWARD_PORT=8101
# Other names that point at this machine (comma-separated); requests under any other name are refused.
#FLIGHTDECK_HOSTNAMES=

# --- Projects -------------------------------------------------------------------------------------
# Projects must live inside this folder; "Add existing" browses it.
#FLIGHTDECK_BROWSE_ROOT=~/dev
# Where "+ New project" creates projects (inside the browse root). Default: the browse root.
#FLIGHTDECK_PROJECTS_DIR=~/dev

# --- Claude Code ----------------------------------------------------------------------------------
# The `claude` binary. Default: ~/.local/bin/claude if it exists, else `claude` on PATH.
#CLAUDE_BIN=
# The model new projects start with (each project and chat can change it). `haiku` spares the plan.
#FLIGHTDECK_MODEL=claude-opus-5-5
# How long an approval card may wait for a click before the tool call is denied.
#FLIGHTDECK_APPROVAL_TIMEOUT_S=1800

# --- Server ---------------------------------------------------------------------------------------
# Where the SQLite database and chat feeds live. The app sets this to its own data folder;
# from a checkout it defaults to ./data.
#FLIGHTDECK_DATA=./data
# Optional second listener for a reverse proxy on another interface; every request on it must carry
# FLIGHTDECK_GATEWAY_SECRET (32+ characters) in an `x-flightdeck-gateway` header.
#FLIGHTDECK_GATEWAY_HOST=
#FLIGHTDECK_GATEWAY_SECRET=
